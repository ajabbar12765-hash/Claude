# Copy this file to .env.local for local `vercel dev` testing, or set the
# same names in Vercel -> Settings -> Environment Variables for a deployment.
# Never commit an actual .env or .env.local file (already gitignored).

# Cloud project registered as "Unpaid usage" at
# https://code.earthengine.google.com/register
EE_PROJECT_ID=

# Paste the *entire* contents of a service account JSON key file
# (IAM & Admin -> Service Accounts -> Keys -> Add key -> JSON) as a single
# value. Keep this secret.
EE_SERVICE_ACCOUNT=

# WeatherNext's Earth Engine asset id. Confirm this yourself in the live
# Earth Engine Data Catalog (https://developers.google.com/earth-engine/datasets)
# before setting it — do not guess.
EE_ASSET_ID=

# "collection" (default) or "image", depending on what EE_ASSET_ID points at.
EE_ASSET_TYPE=collection

# Sample scale in meters (default 25000 if unset).
EE_SCALE_METERS=25000

# ---------------------------------------------------------------------------
# Recommended path (as of Sept 2026): Google Maps Platform Weather API,
# now powered by WeatherNext 3 directly. Plain REST + API key — much
# simpler than the Earth Engine path above. See api/googleweather.js.

# A Maps Platform API key with "Weather API" enabled (Cloud Console ->
# APIs & Services). A free "Maps Demo Key" works for prototyping with no
# card on file; restrict any real key (HTTP referrer / IP) before wider use.
GOOGLE_WEATHER_API_KEY=
