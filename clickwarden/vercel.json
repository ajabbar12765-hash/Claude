{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/gmail/poll.js": { "maxDuration": 60 },
    "api/scan-file.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/gmail/poll", "schedule": "0 5 * * *" }
  ]
}
