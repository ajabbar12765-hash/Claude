{
  "manifest_version": 3,
  "name": "ClickWarden",
  "version": "1.0.0",
  "description": "Checks links and downloads against VirusTotal, Google Safe Browsing, and URLhaus before you click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["webNavigation", "downloads", "storage", "tabs", "notifications", "alarms"],
  "host_permissions": ["<all_urls>"],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
